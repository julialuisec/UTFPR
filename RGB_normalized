def corrigir_balanco_branco(red, green, blue, lux, lux_max):
    # Normalização da intensidade luminosa
    lux_normalized = lux / lux_max * 255.0

    # Aplicação da correção de balanço de branco
    red_corrected = red / lux_normalized
    green_corrected = green / lux_normalized
    blue_corrected = blue / lux_normalized

    return red_corrected, green_corrected, blue_corrected


