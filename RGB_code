#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <SparkFun_APDS9960.h>


////////////////////////////////////////////////////////////////
SparkFun_APDS9960 apds = SparkFun_APDS9960();
Adafruit_SSD1306 display = Adafruit_SSD1306();

uint16_t ambient_light = 0;
uint16_t red_light = 0;
uint16_t green_light = 0;
uint16_t blue_light = 0;

////////////////////////////////////////////////////////////////

int a1, a2, a3, a4, a5, r1, r2, r3, r4, r5, b1, b2, b3, b4, b5, g1, g2, g3, g4, g5;
int sa, sr, sb, sg;
int ma, mr, mb, mg;

////////////////////////////////////////////////////////////////

#define buttonPin  8
#define ledPin 7



void setup() {
  Serial.begin(9600);
  Serial.setTimeout(100);
  pinMode(ledPin, OUTPUT);
  pinMode(buttonPin, INPUT);

  display.clearDisplay();
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C); //Inicializa o Display I2C 0x3C
  display.setTextColor(WHITE);
  display.setTextSize(1);

  if ( !apds.init() ||
       !apds.enableLightSensor(false))
  {
    display.print("Erro na inicialização do sensor");
  }
}

void printcor() {
  display.setCursor(0, 0);
  display.print("A: ");
  display.print(ma);
  display.setCursor(0,20);
  display.print("R: ");
  display.print(mr);
  display.setCursor(70,0);
  display.print("G: ");
  display.print(mg);
  display.setCursor(70,20);
  display.print("B: ");
  display.print(mb);
  display.display();
}



void mediavalores() {
  if (!apds.readAmbientLight(ambient_light) ||
      !apds.readRedLight(red_light) ||
      !apds.readGreenLight(green_light) ||
      !apds.readBlueLight(blue_light) ) {
    display.setCursor(10, 10);
    display.print("Erro aos ler os valores de luz");
    display.display();
  }
  else {
    a1 = ambient_light;
    r1 = red_light;
    b1 = blue_light;
    g1 = green_light;
    delay(200);

    a2 = ambient_light;
    r2 = red_light;
    b2 = blue_light;
    g2 = green_light;
    delay(200);

    a3 = ambient_light;
    r3 = red_light;
    b3 = blue_light;
    g3 = green_light;
    delay(200);
    
a4 = ambient_light;
    r4 = red_light;
    b4 = blue_light;
    g4 = green_light;
    delay(200);

    a5 = ambient_light;
    r5 = red_light;
    b5 = blue_light;
    g5 = green_light;
    delay(50);

    sa = a1 + a2 + a3 + a4 + a5;
    sr = r1 + r2 + r3 + r4 + r5;
    sb = b1 + b2 + b3 + b4 + b5;
    sg = g1 + g2 + g3 + g4 + g5;

    ma = sa / 5;
    mr = sr / 5;
    mb = sb / 5;
    mg = sg / 5;
    delay(50);

    printcor();
  }
}


void loop() {

  int buttonState = digitalRead(buttonPin);

  if (buttonState == 0) {
    digitalWrite(ledPin, 1);
    mediavalores();

  } else {
    digitalWrite(ledPin, 0);
  }
  display.clearDisplay();
  delay(200);
}      
